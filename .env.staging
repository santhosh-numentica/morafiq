APP_ENV=staging
API_BASE_URL=https://staging-api.example.com
API_TIMEOUT=30000
ENABLE_GOOGLE_LOGIN=true
ENABLE_APPLE_LOGIN=true
ENABLE_PASSKEY_LOGIN=true
ENABLE_ANALYTICS=true
ENABLE_ERROR_REPORTING=true
LOG_LEVEL=info
ENABLE_API_LOGGING=true
GOOGLE_CLIENT_ID=your-staging-google-client-id
GOOGLE_IOS_CLIENT_ID=your-staging-google-ios-client-id
GOOGLE_ANDROID_CLIENT_ID=your-staging-google-android-client-id
APPLE_CLIENT_ID=your-staging-apple-client-id
PASSKEY_RP_ID=staging.example.com
PASSKEY_RP_NAME=EnterpriseApp Staging
ANALYTICS_ID=your-staging-analytics-id
SENTRY_DSN=your-staging-sentry-dsn
