APP_ENV=production
API_BASE_URL=https://api.example.com
API_TIMEOUT=30000
ENABLE_GOOGLE_LOGIN=true
ENABLE_APPLE_LOGIN=true
ENABLE_PASSKEY_LOGIN=true
ENABLE_ANALYTICS=true
ENABLE_ERROR_REPORTING=true
LOG_LEVEL=error
ENABLE_API_LOGGING=false
GOOGLE_CLIENT_ID=your-prod-google-client-id
GOOGLE_IOS_CLIENT_ID=your-prod-google-ios-client-id
GOOGLE_ANDROID_CLIENT_ID=your-prod-google-android-client-id
APPLE_CLIENT_ID=your-prod-apple-client-id
PASSKEY_RP_ID=example.com
PASSKEY_RP_NAME=EnterpriseApp
ANALYTICS_ID=your-prod-analytics-id
SENTRY_DSN=your-prod-sentry-dsn
