APP_ENV=development
API_BASE_URL=https://dev-api.example.com
API_TIMEOUT=30000
ENABLE_GOOGLE_LOGIN=false
ENABLE_APPLE_LOGIN=true
ENABLE_PASSKEY_LOGIN=true
ENABLE_ANALYTICS=true
ENABLE_ERROR_REPORTING=true
LOG_LEVEL=debug
ENABLE_API_LOGGING=true
GOOGLE_CLIENT_ID=your-dev-google-client-id
GOOGLE_IOS_CLIENT_ID=your-dev-google-ios-client-id
GOOGLE_ANDROID_CLIENT_ID=your-dev-google-android-client-id
APPLE_CLIENT_ID=your-dev-apple-client-id
PASSKEY_RP_ID=dev.example.com
PASSKEY_RP_NAME=EnterpriseApp Dev
ANALYTICS_ID=your-dev-analytics-id
SENTRY_DSN=
